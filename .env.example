APP_ENV=development
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=65536
UPLOAD_MAX_BYTES=10485760
LOG_LEVEL=INFO
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=
LLM_MODEL=
# Optional absolute path to tesseract.exe when it is not on PATH.
TESSERACT_CMD=
# Optional: factory path returning an object with analyze(ScamAnalysisRequest), e.g. team_rules.engine:create_engine
RULE_ENGINE_FACTORY=

# React frontend: FastAPI versioned API base URL (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
